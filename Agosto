function ScoreCard({ value, label, sub, accent }) {
  return (
    <div style={{
      background: "rgba(255,255,255,0.04)",
      borderRadius: 12,
      padding: "20px 24px",
      borderLeft: `3px solid ${accent || "#555"}`,
      minWidth: 0,
    }}>
      <div style={{ fontSize: 36, fontWeight: 700, color: accent || "#fff", lineHeight: 1.1 }}>{value}</div>
      <div style={{ fontSize: 14, color: "#ccc", marginTop: 6, fontWeight: 500 }}>{label}</div>
      {sub && <div style={{ fontSize: 12, color: "#888", marginTop: 4 }}>{sub}</div>}
    </div>
  );
}

function HeatmapCell({ cited, tool }) {
  return (
    <div style={{
      width: 40,
      height: 40,
      borderRadius: 6,
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      background: cited ? `${TOOL_COLORS[tool]}22` : "rgba(255,255,255,0.03)",
      border: cited ? `1.5px solid ${TOOL_COLORS[tool]}` : "1.5px solid rgba(255,255,255,0.06)",
      fontSize: 16,
      transition: "all 0.15s",
    }}>
      {cited ? "✓" : "—"}
    </div>
  );
}

function CompetitorBar({ comp, maxCount }) {
  const pct = (comp.count / maxCount) * 100;
  return (
    <div style={{ marginBottom: 12 }}>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline", marginBottom: 4 }}>
        <span style={{ fontSize: 13, color: "#ddd", fontWeight: 500 }}>
          {comp.name}
          {comp.tag && (
            <span style={{
              marginLeft: 8,
              fontSize: 10,
              background: "#ef444433",
              color: "#f87171",
              padding: "2px 8px",
              borderRadius: 20,
              fontWeight: 600,
              letterSpacing: 0.3,
            }}>{comp.tag}</span>
          )}
        </span>
        <span style={{ fontSize: 12, color: "#888" }}>{comp.count}/3 IAs</span>
      </div>
      <div style={{ display: "flex", gap: 4, alignItems: "center" }}>
        <div style={{
          flex: 1,
          height: 6,
          background: "rgba(255,255,255,0.06)",
          borderRadius: 3,
          overflow: "hidden",
        }}>
          <div style={{
            width: `${pct}%`,
            height: "100%",
            background: comp.count === 3
              ? "linear-gradient(90deg, #ef4444, #f97316)"
              : comp.count === 2
              ? "linear-gradient(90deg, #fbbf24, #f59e0b)"
              : "#666",
            borderRadius: 3,
            transition: "width 0.4s ease",
          }} />
        </div>
        <div style={{ display: "flex", gap: 3, marginLeft: 8 }}>
          {TOOLS.map(t => (
            <div key={t} style={{
              width: 8,
              height: 8,
              borderRadius: "50%",
              background: comp.tools.includes(t) ? TOOL_COLORS[t] : "rgba(255,255,255,0.08)",
              border: `1px solid ${comp.tools.includes(t) ? TOOL_COLORS[t] : "rgba(255,255,255,0.1)"}`,
            }} />
          ))}
        </div>
      </div>
    </div>
  );
}

function ToolLegend() {
