<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Diagnóstico de Citação por IA — Dr. Maurício Orel</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    min-height: 100vh;
    background: #0f1117;
    color: #e4e4e7;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    padding: 32px 24px;
    -webkit-font-smoothing: antialiased;
  }
  .container { max-width: 900px; margin: 0 auto; }

  /* Header */
  .eyebrow { font-size: 11px; color: #888; letter-spacing: 1.5px; margin-bottom: 8px; font-weight: 600; }
  h1 { font-size: 28px; font-weight: 700; color: #fff; line-height: 1.2; }
  .subtitle { font-size: 14px; color: #888; margin-top: 8px; line-height: 1.5; }

  /* Score cards */
  .scores { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin: 32px 0; }
  .score-card {
    background: rgba(255,255,255,0.04);
    border-radius: 12px;
    padding: 20px 24px;
    border-left: 3px solid var(--accent);
  }
  .score-card .value { font-size: 36px; font-weight: 700; color: var(--accent); line-height: 1.1; }
  .score-card .label { font-size: 14px; color: #ccc; margin-top: 6px; font-weight: 500; }
  .score-card .sub { font-size: 12px; color: #888; margin-top: 4px; }

  /* Panels */
  .panel {
    background: rgba(255,255,255,0.03);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
  }
  .panel h2 { font-size: 16px; font-weight: 600; color: #fff; margin-bottom: 4px; }
  .panel .panel-sub { font-size: 12px; color: #888; margin-bottom: 20px; }

  /* Heatmap */
  .heatmap-wrapper { overflow-x: auto; }
  .heatmap-table { min-width: 500px; }
  .heatmap-row { display: flex; align-items: center; margin-bottom: 6px; }
  .heatmap-label { width: 120px; font-size: 13px; font-weight: 600; flex-shrink: 0; }
  .heatmap-cell-wrap { width: 44px; display: flex; justify-content: center; }
  .heatmap-cell {
    width: 40px; height: 40px; border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; transition: all 0.15s; cursor: default;
  }
  .heatmap-cell.cited { border: 1.5px solid var(--tool-color); background: var(--tool-bg); color: #e4e4e7; }
  .heatmap-cell.not-cited { border: 1.5px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.03); color: #555; }

  .col-headers, .col-labels { display: flex; padding-left: 120px; }
  .col-header { width: 44px; text-align: center; font-size: 10px; font-weight: 600; cursor: default; transition: color 0.15s; }
  .col-label { width: 44px; text-align: center; font-size: 9px; color: #666; line-height: 1.3; }
  .col-labels { margin-top: 12px; border-top: 1px solid rgba(255,255,255,0.06); padding-top: 12px; }

  /* Legends */
  .legend { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 16px; }
  .legend-item { display: flex; align-items: center; gap: 6px; font-size: 11px; color: #888; }
  .legend-dot { width: 8px; height: 8px; border-radius: 2px; }
  .legend-dot.round { border-radius: 50%; width: 10px; height: 10px; }

  /* Tooltip */
  .tooltip-bar {
    background: rgba(251,191,36,0.08);
    border: 1px solid rgba(251,191,36,0.2);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 24px;
    font-size: 13px;
    color: #fbbf24;
    display: none;
  }
  .tooltip-bar.visible { display: block; }
  .tooltip-bar .tq { color: #888; margin-left: 8px; }

  /* Two-col */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
  @media (max-width: 700px) { .two-col { grid-template-columns: 1fr; } }

  /* Competitor bars */
  .comp { margin-bottom: 12px; }
  .comp-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
  .comp-name { font-size: 13px; color: #ddd; font-weight: 500; }
  .comp-tag {
    margin-left: 8px; font-size: 10px;
    background: rgba(239,68,68,0.2); color: #f87171;
    padding: 2px 8px; border-radius: 20px; font-weight: 600; letter-spacing: 0.3px;
  }
  .comp-count { font-size: 12px; color: #888; }
  .comp-bar-wrap { display: flex; gap: 4px; align-items: center; }
  .comp-track { flex: 1; height: 6px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden; }
  .comp-fill { height: 100%; border-radius: 3px; transition: width 0.4s ease; }
  .comp-dots { display: flex; gap: 3px; margin-left: 8px; }
  .comp-dot { width: 8px; height: 8px; border-radius: 50%; }

  /* Diagnostic cards */
  .diag-card { border-radius: 8px; padding: 14px 16px; margin-bottom: 12px; }
  .diag-card .diag-title { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
  .diag-card .diag-desc { font-size: 12px; color: #aaa; line-height: 1.5; }

  /* Action items */
  .actions-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px; }
  .action-card {
    background: rgba(255,255,255,0.03);
    border-radius: 8px;
    padding: 14px 16px;
    border-left: 3px solid var(--accent);
  }
  .action-head { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
  .action-tag {
    font-size: 10px; font-weight: 700;
    color: var(--accent); background: var(--accent-bg);
    padding: 2px 8px; border-radius: 4px;
  }
  .action-title { font-size: 13px; font-weight: 600; color: #e4e4e7; }
  .action-desc { font-size: 12px; color: #888; line-height: 1.5; }

  /* Footer */
  .footer {
    margin-top: 24px; padding: 16px 0;
    border-top: 1px solid rgba(255,255,255,0.06);
    display: flex; justify-content: space-between;
    font-size: 11px; color: #555;
    flex-wrap: wrap; gap: 8px;
  }
</style>
</head>
<body>
<div class="container">

  <!-- Header -->
  <div class="eyebrow">DIAGNÓSTICO DE VISIBILIDADE IA</div>
  <h1>Dr. Maurício Orel</h1>
  <p class="subtitle">Citação em ChatGPT, Gemini e Perplexity — 7 perguntas por ferramenta, do específico ao genérico.</p>

  <!-- Score cards -->
  <div class="scores">
    <div class="score-card" style="--accent:#f87171">
      <div class="value">19%</div>
      <div class="label">Visibilidade geral</div>
      <div class="sub">4 de 21 testes</div>
    </div>
    <div class="score-card" style="--accent:#ef4444">
      <div class="value">0/15</div>
      <div class="label">Citações genéricas</div>
      <div class="sub">Perguntas sem nome dele</div>
    </div>
    <div class="score-card" style="--accent:#fbbf24">
      <div class="value">0/3</div>
      <div class="label">Pós-bariátrica SP</div>
      <div class="sub">Pergunta-chave do nicho</div>
    </div>
    <div class="score-card" style="--accent:#8b5cf6">
      <div class="value">8</div>
      <div class="label">Concorrentes à frente</div>
      <div class="sub">Citados em 2+ ferramentas</div>
    </div>
  </div>

  <!-- Heatmap -->
  <div class="panel">
    <h2>Matriz de citação</h2>
    <p class="panel-sub">Cada célula = uma pergunta feita a uma IA. Check = Maurício citado.</p>
    <div class="heatmap-wrapper">
      <div class="heatmap-table">
        <div class="col-headers" id="colHeaders"></div>
        <div id="heatmapRows"></div>
        <div class="col-labels" id="colLabels"></div>
      </div>
    </div>
    <div class="legend" id="levelLegend"></div>
  </div>

  <!-- Tooltip -->
  <div class="tooltip-bar" id="tooltip"></div>

  <!-- Two columns -->
  <div class="two-col">
    <!-- Competitors -->
    <div class="panel" style="margin-bottom:0">
      <h2>Concorrentes citados em 2+ IAs</h2>
      <p class="panel-sub">Quem aparece onde o Maurício não aparece</p>
      <div class="legend" id="toolLegend" style="margin-top:0;margin-bottom:16px"></div>
      <div id="competitors"></div>
    </div>

    <!-- Diagnostic -->
    <div class="panel" style="margin-bottom:0">
      <h2>Diagnóstico</h2>
      <div style="margin-top:16px" id="diagnostics"></div>
    </div>
  </div>

  <!-- Action plan -->
  <div class="panel">
    <h2 style="margin-bottom:16px">Plano de ação</h2>
    <div class="actions-grid" id="actions"></div>
  </div>

  <!-- Footer -->
  <div class="footer">
    <span>ClintIA Soluções Tecnológicas</span>
    <span>Ago 2026 — Dados coletados em janela limpa (sem histórico)</span>
  </div>
</div>

<script>
const TOOLS = [
  { name: "ChatGPT", color: "#74aa9c" },
  { name: "Gemini", color: "#8b5cf6" },
  { name: "Perplexity", color: "#3b82f6" },
];

const QUESTIONS = [
  { id:1, text:"Quem é Maurício Orel, cirurgião plástico?", level:"Específico", short:"Nome direto" },
  { id:2, text:"Fale sobre a Clínica Orel em São Paulo", level:"Específico", short:"Clínica" },
  { id:3, text:"Cirurgia plástica em São Paulo", level:"Intermediário", short:"Plástica SP" },
  { id:4, text:"Cirurgia pós-bariátrica em São Paulo", level:"Intermediário", short:"Pós-bariátrica SP" },
  { id:5, text:"Melhores cirurgiões pós-bariátricos em SP", level:"Amplo", short:"Top cirurgiões SP" },
  { id:6, text:"Melhores cirurgias pós-bariátricas em SP", level:"Amplo", short:"Top cirurgias SP" },
  { id:7, text:"Melhores cirurgiões pós-bariátricos do Brasil", level:"Muito amplo", short:"Top Brasil" },
];

const MATRIX = {
  ChatGPT:    [true, true, false, false, false, false, false],
  Gemini:     [true, false, false, false, false, false, false],
  Perplexity: [true, true, false, false, false, false, false],
};

const LEVEL_COLORS = { "Específico":"#4ade80", "Intermediário":"#fbbf24", "Amplo":"#f87171", "Muito amplo":"#ef4444" };

const COMPETITORS = [
  { name:"Dr. André Araújo", tools:["ChatGPT","Gemini","Perplexity"], count:3, tag:"Líder absoluto" },
  { name:"Dr. Moacyr Pires de Mello Filho", tools:["ChatGPT","Gemini","Perplexity"], count:3 },
  { name:"Dra. Thamy Motoki", tools:["ChatGPT","Perplexity"], count:2 },
  { name:"Dr. Juan Montano", tools:["Gemini","Perplexity"], count:2 },
  { name:"Dr. Henrique Lopes Arantes", tools:["ChatGPT","Gemini"], count:2 },
  { name:"Dr. Orlando Ferrari", tools:["ChatGPT","Gemini"], count:2 },
  { name:"Dr. Daniel Debastiani", tools:["ChatGPT","Gemini"], count:2 },
  { name:"Dr. Guilherme Teixeira", tools:["ChatGPT","Perplexity"], count:2 },
];

const DIAGNOSTICS = [
  { color:"#f87171", bg:"rgba(239,68,68,0.08)", border:"rgba(239,68,68,0.15)", title:"Invisível no nicho-chave", desc:"Zero citações em \"pós-bariátrica SP\" — exatamente o território do OREL 360. O nome só aparece quando já está na pergunta." },
  { color:"#fbbf24", bg:"rgba(251,191,36,0.08)", border:"rgba(251,191,36,0.15)", title:"Dados inconsistentes entre fontes", desc:"RQE divergente, endereço \"Vila Nova Conceição\" fantasma no Gemini. Isso reduz confiança dos modelos em citá-lo." },
  { color:"#4ade80", bg:"rgba(74,222,128,0.08)", border:"rgba(74,222,128,0.15)", title:"Ativo de autoridade subutilizado", desc:"Matéria Folha de S.Paulo (2018) detectada apenas pelo Perplexity. Linkagem fraca no site = sinal desperdiçado." },
  { color:"#8b5cf6", bg:"rgba(139,92,246,0.08)", border:"rgba(139,92,246,0.15)", title:"Benchmark: Dr. André Araújo", desc:"Presente nas 3 IAs em perguntas genéricas. Instituto com nome próprio + conteúdo dedicado + múltiplas fontes externas." },
];

const ACTIONS = [
  { p:"P0", color:"#ef4444", title:"Padronizar dados em todas as plataformas", desc:"GBP, Doctoralia, site, redes sociais — mesmo RQE, endereços, especialidades." },
  { p:"P0", color:"#ef4444", title:"Conteúdo dedicado: pós-bariátrica SP", desc:"Páginas long-form com o termo exato que as IAs buscam. Linkagem interna forte." },
  { p:"P1", color:"#fbbf24", title:"Reforçar linkagem Folha de S.Paulo", desc:"Citar e linkar matéria de 2018 no site + Doctoralia + GBP. Sinal tier-1." },
  { p:"P1", color:"#fbbf24", title:"Benchmark André Araújo", desc:"Auditoria de site, backlinks e fontes externas. Replicar estrutura adaptando pro OREL 360." },
  { p:"P2", color:"#8b5cf6", title:"Testar Claude + Meta AI", desc:"Rodar mesma bateria no Claude (com login) e Meta AI (WhatsApp) para completar panorama." },
  { p:"P2", color:"#8b5cf6", title:"Marca OREL 360 no conteúdo público", desc:"O método proprietário precisa existir como conteúdo indexável, não só em ads." },
];

// Build heatmap
const colHeaders = document.getElementById("colHeaders");
const colLabels = document.getElementById("colLabels");
const heatmapRows = document.getElementById("heatmapRows");
const tooltip = document.getElementById("tooltip");

function showTooltip(q) {
  tooltip.innerHTML = `<strong>P${q.id}:</strong> ${q.text}<span class="tq">(${q.level})</span>`;
  tooltip.classList.add("visible");
}
function hideTooltip() { tooltip.classList.remove("visible"); }

QUESTIONS.forEach(q => {
  const h = document.createElement("div");
  h.className = "col-header";
  h.style.color = LEVEL_COLORS[q.level];
  h.textContent = "P" + q.id;
  h.addEventListener("mouseenter", () => showTooltip(q));
  h.addEventListener("mouseleave", hideTooltip);
  colHeaders.appendChild(h);

  const l = document.createElement("div");
  l.className = "col-label";
  l.textContent = q.short;
  colLabels.appendChild(l);
});

TOOLS.forEach(tool => {
  const row = document.createElement("div");
  row.className = "heatmap-row";
  const label = document.createElement("div");
  label.className = "heatmap-label";
  label.style.color = tool.color;
  label.textContent = tool.name;
  row.appendChild(label);

  QUESTIONS.forEach((q, i) => {
    const wrap = document.createElement("div");
    wrap.className = "heatmap-cell-wrap";
    const cell = document.createElement("div");
    const cited = MATRIX[tool.name][i];
    cell.className = "heatmap-cell " + (cited ? "cited" : "not-cited");
    if (cited) {
      cell.style.setProperty("--tool-color", tool.color);
      cell.style.setProperty("--tool-bg", tool.color + "22");
      cell.style.borderColor = tool.color;
      cell.style.background = tool.color + "22";
    }
    cell.textContent = cited ? "✓" : "—";
    cell.addEventListener("mouseenter", () => showTooltip(q));
    cell.addEventListener("mouseleave", hideTooltip);
    wrap.appendChild(cell);
    row.appendChild(wrap);
  });
  heatmapRows.appendChild(row);
});

// Level legend
const levelLegend = document.getElementById("levelLegend");
Object.entries(LEVEL_COLORS).forEach(([level, color]) => {
  const item = document.createElement("div");
  item.className = "legend-item";
  item.innerHTML = `<div class="legend-dot" style="background:${color}"></div>${level}`;
  levelLegend.appendChild(item);
});

// Tool legend
const toolLegend = document.getElementById("toolLegend");
TOOLS.forEach(t => {
  const item = document.createElement("div");
  item.className = "legend-item";
  item.innerHTML = `<div class="legend-dot round" style="background:${t.color}"></div><span style="font-size:12px;color:#aaa">${t.name}</span>`;
  toolLegend.appendChild(item);
});

// Competitors
const compEl = document.getElementById("competitors");
COMPETITORS.forEach(c => {
  const pct = (c.count / 3) * 100;
  const grad = c.count === 3
    ? "linear-gradient(90deg,#ef4444,#f97316)"
    : "linear-gradient(90deg,#fbbf24,#f59e0b)";
  const dots = TOOLS.map(t => {
    const active = c.tools.includes(t.name);
    return `<div class="comp-dot" style="background:${active ? t.color : 'rgba(255,255,255,0.08)'};border:1px solid ${active ? t.color : 'rgba(255,255,255,0.1)'}"></div>`;
  }).join("");
  compEl.innerHTML += `
    <div class="comp">
      <div class="comp-head">
        <span class="comp-name">${c.name}${c.tag ? `<span class="comp-tag">${c.tag}</span>` : ""}</span>
        <span class="comp-count">${c.count}/3 IAs</span>
      </div>
      <div class="comp-bar-wrap">
        <div class="comp-track"><div class="comp-fill" style="width:${pct}%;background:${grad}"></div></div>
        <div class="comp-dots">${dots}</div>
      </div>
    </div>`;
});

// Diagnostics
const diagEl = document.getElementById("diagnostics");
DIAGNOSTICS.forEach(d => {
  diagEl.innerHTML += `
    <div class="diag-card" style="background:${d.bg};border:1px solid ${d.border}">
      <div class="diag-title" style="color:${d.color}">${d.title}</div>
      <div class="diag-desc">${d.desc}</div>
    </div>`;
});

// Actions
const actEl = document.getElementById("actions");
ACTIONS.forEach(a => {
  actEl.innerHTML += `
    <div class="action-card" style="--accent:${a.color};--accent-bg:${a.color}1a">
      <div class="action-head">
        <span class="action-tag">${a.p}</span>
        <span class="action-title">${a.title}</span>
      </div>
      <div class="action-desc">${a.desc}</div>
    </div>`;
});
</script>
</body>
</html>
